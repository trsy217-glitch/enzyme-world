rules_version = '2';

/* 효소세상(enzyme-world) — 회원 등급 Firestore 보안 규칙
   · members/{uid}: 본인과 회사 관리자만 읽을 수 있습니다.
   · 등급(grade)은 본인이 바꿀 수 없습니다. 본인은 이름·연락처만 고칠 수 있습니다.
   · 회사 관리자는 config/admin 문서의 emails 목록에 있고 이메일 인증이 끝난 계정입니다.
     (이메일/비밀번호로 새로 만든 계정은 인증 전까지 관리자로 인정되지 않습니다.)
   · config/admin 은 콘솔에서만 수정합니다(클라이언트 쓰기 금지). */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return get(/databases/$(database)/documents/config/admin).data.emails;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() in adminEmails();
    }

    function validGrade() {
      return request.resource.data.grade in ['normal', 'dealer', 'master'];
    }

    function memberFields() {
      return ['email', 'name', 'phone', 'grade', 'joinedAt', 'updatedAt', 'history'];
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      /* 가입: 본인 uid 문서만, 기본 등급 일반회원, 정해진 항목만 저장 */
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly(memberFields())
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.grade == 'normal'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.history is list
        && request.resource.data.history.size() >= 1;

      allow update: if signedIn() && (
        /* 본인: 이름·연락처·수정일만 변경 가능 (등급·이메일·가입일·이력 잠금) */
        (request.auth.uid == uid
          && request.resource.data.grade == resource.data.grade
          && request.resource.data.email == resource.data.email
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.history == resource.data.history
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']))
        /* 회사 관리자: 등급·이력 변경 가능 (이메일·가입일은 변경 불가) */
        || (isAdmin()
          && validGrade()
          && request.resource.data.email == resource.data.email
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.keys().hasOnly(memberFields()))
      );

      allow delete: if false;
    }
  }
}
