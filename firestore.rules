rules_version = '2';

/* 효소세상(enzyme-world) — 회원 등급 Firestore 보안 규칙
   콘솔(Firestore > 규칙)에 게시된 내용과 같은 규칙입니다(줄바꿈만 다름).

   · members/{uid} : 본인과 회사 관리자만 읽기
   · 등급(grade)은 본인이 바꿀 수 없음. 본인은 이름·연락처만 수정 가능
   · 회사 관리자 = config/admin 문서 emails 목록에 있고 이메일 인증이 끝난 계정
     (이메일·비밀번호로 새로 만든 계정은 인증 전까지 관리자로 인정되지 않음)
   · config/admin 은 콘솔에서만 수정(클라이언트 쓰기 규칙 없음 = 기본 거부)
   · 삭제 규칙을 두지 않았으므로 문서 삭제는 모두 거부됨 */
service cloud.firestore {
  match /databases/{database}/documents {

    function ok() {
      return request.auth != null;
    }

    function adm() {
      return ok()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admin).data.emails;
    }

    match /config/{d} {
      allow read: if ok();
    }

    match /members/{uid} {
      allow read: if ok() && (request.auth.uid == uid || adm());

      allow create: if ok()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'phone', 'grade', 'joinedAt', 'updatedAt', 'history'])
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.grade == 'normal';

      allow update: if ok() && (
        (request.auth.uid == uid
          && request.resource.data.grade == resource.data.grade
          && request.resource.data.email == resource.data.email
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.history == resource.data.history
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']))
        || (adm()
          && request.resource.data.grade in ['normal', 'dealer', 'master']
          && request.resource.data.email == resource.data.email
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.keys().hasOnly(['email', 'name', 'phone', 'grade', 'joinedAt', 'updatedAt', 'history']))
      );
    }
  }
}
